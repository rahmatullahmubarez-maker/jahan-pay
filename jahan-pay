<script>
const services=[
 {id:'transfer',icon:'↗',title:'انتقال پول',desc:'ارسال وجه',one:'شماره مقصد',two:'مبلغ (افغانی)'},
 {id:'recharge',icon:'▣',title:'شارژ موبایل',desc:'شارژ سیم‌کارت',one:'شماره موبایل',two:'مبلغ شارژ (افغانی)'},
 {id:'internet',icon:'⌁',title:'بسته اینترنت',desc:'بسته‌های اینترنتی',one:'شماره موبایل',two:'قیمت بسته (افغانی)'},
