function openPage(id){show(id);if(id==='transactions')renderTx('allTx');if(id==='admin')renderTx('adminTx');}
document.querySelectorAll('.navbtn').forEach(b=>b.addEventListener('click',()=>openPage(b.dataset.page)));
function openService(id){if(id==='history'){openPage('transactions');return}currentAction=id;let s=services.find(x=>x.id===id)||services[0];show('action');document.getElementById('actionTitle').textContent=s.title;document.getElementById('actionDesc').textContent=s.desc+' — ثبت درخواست به‌صورت آزمایشی';document.getElementById('fieldOneLabel').textContent=s.one;document.getElementById('fieldTwoLabel').textContent=s.two;document.getElementById('fieldOne').value='';document.getElementById('fieldTwo').value='';document.getElementById('memo').value='';}
function renderTx(target){let el=document.getElementById(target);if(!txs.length){el.innerHTML='<p style="color:var(--muted);font-size:13px">هنوز فعالیتی ثبت نشده است.</p>';return}el.innerHTML=txs.slice().reverse().map(t=>`<div class="tx"><div class="txico">${t.icon}</div><div class="txtext"><b>${t.title}</b><small>${t.ref} · ${t.date}</small><small>${t.destination}</small></div><div class="amount">${faNum(t.amount)} ؋<br><small class="pill">ثبت آزمایشی</small></div></div>`).join('')}
document.getElementById('actionForm').addEventListener('submit',e=>{e.preventDefault();let s=services.find(x=>x.id===currentAction);let amount=document.getElementById('fieldTwo').value;let dest=document.getElementById('fieldOne').value.trim();txs.push({title:s.title,icon:s.icon,amount:amount,ref:'JP-'+Date.now().toString().slice(-6),date:new Date().toLocaleDateString('fa-AF'),destination:dest});renderTx('recentTx');renderTx('allTx');renderTx('adminTx');document.getElementById('txCount').textContent=faNum(txs.length);document.getElementById('adminTxCount').textContent=faNum(txs.length);alert('درخواست آزمایشی ثبت شد. هیچ پرداخت واقعی انجام نشده است.');openPage('transactions')});
document.getElementById('loginForm').addEventListener('submit',e=>{e.preventDefault();userPhone=document.getElementById('phone').value.trim();if(!userPhone)return;document.getElementById('profilePhone').value=userPhone;document.getElementById('loginView').classList.remove('active');document.getElementById('appView').classList.add('active');document.getElementById('today').textContent=new Date().toLocaleDateString('fa-AF',{weekday:'long',year:'numeric',month:'long',day:'numeric'});renderTx('recentTx');});
